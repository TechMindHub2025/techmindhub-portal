---
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { categories, collections, articleInCollection } from "../data/discovery";

const all = await getCollection("posts", ({ data }) => data.status === "published");

// newest first
const posts = [...all].sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const latest = posts.slice(0, 6);

const pageTitle = "TechMind Hub";
const pageDescription =
  "Source-linked engineering analysis of AI, robotics, infrastructure and emerging technology: what was demonstrated, what remains uncertain, and what to test next.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="tmh-container tmh-stack">
    <!-- HERO -->
    <div class="tmh-hero reveal">
      <div class="heroBg" aria-hidden="true"></div>
      <div class="tmh-hero__text">
        <h1 class="tmh-h1">TechMind Hub</h1>
        <p class="tmh-lead">
          Strategic technology analysis grounded in engineering evidence. Timely briefings explain what changed; deeper research explores why it matters.
        </p>

        <div class="tmh-actions">
          <a class="tmh-btn tmh-btn--primary" href="/deep-dives">Explore Deep Dives</a>
          <a class="tmh-btn" href="/posts">Latest analysis</a>
          <a class="tmh-btn" href="/about">About</a>
        </div>

        <div class="tmh-pills">
          <span class="tmh-pill">Engineering analysis</span>
          <span class="tmh-pill">Primary sources</span>
          <span class="tmh-pill">Evidence and limitations</span>
        </div>
      </div>

      <div class="tmh-hero__panel">
        <div class="tmh-panel">
          <div class="tmh-panel__title">Start here</div>
          <ul class="tmh-list">
            <li><a href="/deep-dives">Strategic research</a></li>
            <li><a href="/collections">Connected reading collections</a></li>
            <li><a href="/topics">Eight technology categories</a></li>
            <li><a href="/about">Editorial method</a></li>
          </ul>
          <div class="tmh-panel__hint">
            Start with a subject, then follow the sources and the engineering questions.
          </div>
        </div>
      </div>
    </div>

    <!-- LATEST -->
    <div class="tmh-section reveal">
      <div class="tmh-section__head">
        <h2 class="tmh-h2">Latest</h2>
        <a class="source" href="/posts">View all →</a>
      </div>

      <div class="tmh-grid">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    </div>

    <!-- TOPICS -->
    <div class="tmh-section reveal">
      <div class="tmh-section__head">
        <h2 class="tmh-h2">Topics</h2>
        <a class="source" href="/topics">Browse →</a>
      </div>

      <div class="tmh-tagsCloud">
        {categories.filter(c => posts.some(p => (c.domains as readonly string[]).includes(p.data.domain ?? ""))).map((c) => (
          <a class="tmh-pill tmh-pill--link" href={`/posts/?category=${c.id}`}>{c.label}</a>
        ))}
      </div>
    </div>

    <div class="tmh-section reveal">
      <div class="tmh-section__head"><h2 class="tmh-h2">Research collections</h2><a class="source" href="/collections/">All collections →</a></div>
      <div class="discovery-grid">
        {collections.map(collection => <a class="discovery-tile" href={`/collections/${collection.id}/`}>
          <span class="discovery-tile__label">{collection.label}</span>
          <span>{collection.description}</span>
          <span class="discovery-tile__count">{posts.filter(post => articleInCollection(post.data.tags, collection.tags)).length} connected articles →</span>
        </a>)}
      </div>
    </div>

    <div class="tmh-section tmh-callout reveal">
      <h2 class="tmh-h2">Follow the research</h2>
      <p class="tmh-lead">Get new analyses in your reading list, or follow updates on the channels where you already work.</p>
      <div class="tmh-actions">
        <a class="tmh-btn tmh-btn--primary" href="https://arover.substack.com/" target="_blank" rel="noopener noreferrer">Read on Substack</a>
        <a class="tmh-btn" href="/feed.xml">Subscribe via RSS</a>
      </div>
    </div>

    <!-- DISCUSS -->
    <div class="tmh-section tmh-callout reveal">
      <h2 class="tmh-h2">Where to discuss</h2>
      <p class="tmh-lead">
        Discuss the analysis in the TechMind Hub community or explore the sources in each article.
      </p>

      <div class="tmh-actions">
        <a class="tmh-btn" href="/posts">Open archive</a>
        <a class="tmh-btn" href="/circle">Join the Circle</a>
      </div>
    </div>
  </section>
</BaseLayout>



<script>
  const heroBg = document.querySelector('.heroBg');
  const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const PARALLAX_FACTOR = 0.22;
  const MAX_TRAVEL = 20;

  if (heroBg && !mediaQuery.matches) {
    let ticking = false;

    const updateParallax = () => {
      const offset = Math.min(MAX_TRAVEL, Math.round(window.scrollY * PARALLAX_FACTOR));
      heroBg.style.transform = `translate3d(0, ${offset}px, 0)`;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(updateParallax);
      }
    };

    updateParallax();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
