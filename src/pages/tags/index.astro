---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const all = await getCollection("posts");
const published = all.filter((p) => p.data.status !== "draft");

// tags + counts
const counts = new Map<string, number>();
for (const p of published) {
  for (const t of (p.data.tags ?? [])) {
    counts.set(t, (counts.get(t) ?? 0) + 1);
  }
}

const tags = [...counts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const tagHref = (t: string) => `${base}tags/${encodeURIComponent(t)}/`;
---

<BaseLayout title="Tags">
  <main class="wrap">
    <section class="page">
      <header class="pageHeader">
        <h1 class="pageTitle">Tags</h1>
        <p class="pageLead">Browse by topic.</p>
      </header>

      <div class="tmh-tagsCloud reveal">
        {tags.map(([t, n]) => (
          <a class="tmh-pill tmh-pill--link" href={tagHref(t)}>#{t} <span class="count">{n}</span></a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .count { opacity:.7; margin-left:6px; font-size:12px; }
</style>
