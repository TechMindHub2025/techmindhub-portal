---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("posts", ({data}) => data.status === "published")).sort((a,b) => +b.data.pubDate - +a.data.pubDate || a.slug.localeCompare(b.slug));
const allTags = [...new Set(posts.flatMap(p => p.data.tags).filter(t => t !== "TechMindHub"))].sort();
---
<BaseLayout title="Analysis — TechMind Hub" description="Explore TechMind Hub analysis by topic, title and date.">
  <section class="page">
    <header class="pageHeader"><div><h1 class="pageTitle">Analysis</h1><p class="pageLead">Explore ideas across science and technology.</p></div></header>
    <form class="archive-controls" action="/posts" method="get" hidden data-archive-controls>
      <label class="archive-search">Search articles<input type="search" name="q" placeholder="Title, topic or keyword" autocomplete="off" /></label>
      <label>Topic<select name="tag"><option value="">All topics</option>{allTags.map(t => <option value={t}>{t}</option>)}</select></label>
      <label>Sort<select name="sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select></label>
    </form>
    <noscript><p>Browse by <a href="/tags/">topic</a>, or explore all articles below.</p></noscript>
    <p class="archive-count" data-archive-count aria-live="polite">{posts.length} articles</p>
    <div class="grid">
      {posts.map(post => <div data-archive-entry data-search={`${post.data.title} ${post.data.description} ${post.data.topic || ""} ${post.data.tags.join(" ")}`.toLowerCase()} data-tags={JSON.stringify(post.data.tags)} data-date={post.data.pubDate.toISOString()} data-slug={post.slug}><PostCard post={post} /></div>)}
    </div>
    <p data-archive-empty hidden>No articles match. Try another keyword or choose all topics.</p>
  </section>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-archive-controls]');
  const count = document.querySelector('[data-archive-count]');
  const empty = document.querySelector<HTMLElement>('[data-archive-empty]');
  const entries = [...document.querySelectorAll<HTMLElement>('[data-archive-entry]')];
  if (form) {
    const query = form.elements.namedItem('q') as HTMLInputElement;
    const tag = form.elements.namedItem('tag') as HTMLSelectElement;
    const sort = form.elements.namedItem('sort') as HTMLSelectElement;
    const readURL = () => {
      const params = new URLSearchParams(location.search);
      query.value = params.get('q') || '';
      tag.value = [...tag.options].find(o => o.value.toLowerCase() === (params.get('tag') || '').toLowerCase())?.value || '';
      sort.value = params.get('sort') === 'oldest' ? 'oldest' : 'newest';
    };
    const update = (writeURL = true) => {
      const words = query.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let visible = 0;
      entries.sort((a,b) => a.dataset.date!.localeCompare(b.dataset.date!) * (sort.value === 'oldest' ? 1 : -1) || a.dataset.slug!.localeCompare(b.dataset.slug!));
      for (const entry of entries) {
        const tags: string[] = JSON.parse(entry.dataset.tags || '[]');
        entry.hidden = !words.every(w => entry.dataset.search!.includes(w)) || (!!tag.value && !tags.includes(tag.value));
        if (!entry.hidden) visible++;
        entry.parentElement!.append(entry);
      }
      if (count) count.textContent = `${visible} ${visible === 1 ? 'article' : 'articles'}`;
      if (empty) empty.hidden = visible !== 0;
      if (writeURL) {
        const params = new URLSearchParams();
        if (query.value.trim()) params.set('q', query.value.trim());
        if (tag.value) params.set('tag', tag.value);
        if (sort.value === 'oldest') params.set('sort', 'oldest');
        history.replaceState(null, '', location.pathname + (params.size ? '?' + params : ''));
      }
    };
    readURL(); update(false); form.hidden = false;
    form.addEventListener('input', () => update());
    form.addEventListener('change', () => update());
    form.addEventListener('submit', e => { e.preventDefault(); update(); });
    window.addEventListener('popstate', () => { readURL(); update(false); });
  }
</script>
