---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export const prerender = true;

const FORM_ACTION = import.meta.env.PUBLIC_TMH_CONTACT_FORM_ACTION;

const FB_CIRCLE_URL =
  import.meta.env.PUBLIC_FB_CIRCLE_URL ||
  "https://www.facebook.com/groups/techmindhub";

const LINKEDIN_URL =
  import.meta.env.PUBLIC_LINKEDIN_URL ||
  "https://www.linkedin.com/in/andrew-rover-799772ba/";

const FB_PROFILE_URL =
  import.meta.env.PUBLIC_FB_PROFILE_URL ||
  "https://www.facebook.com/andrew.rover.2024";

const all = await getCollection("posts", ({ data }) => data.status === "published");

// newest first
const posts = [...all].sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const latest = posts.slice(0, 6);

// tag cloud (top 12 by count)
const tagCounts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags ?? []) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const topTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12)
  .map(([t]) => t);
  
---

<BaseLayout
  title="About — TechMind Hub"
  description="What TechMind Hub is, who it’s for, how publishing works, and how to get in touch."
>
  <section class="page">
    <header class="pageHeader">
      <h1 class="pageTitle">About TechMind Hub</h1>
      <p class="pageLead">
        TechMind Hub is a curated stream of practical signals across AI, robotics, automation, and enterprise technology.
        The goal is simple: capture what matters, summarize it clearly, and keep it searchable and shareable — without noise.
      </p>

      <div class="pageActions">
        <a class="tmh-btn tmh-btn--primary" href="/posts">Browse Analysis</a>
        <a class="tmh-btn" href="/tags">Explore Tags</a>
        <a class="tmh-btn" href="/circle">Join the Circle</a>
      </div>
    </header>
        <div class="aboutGrid reveal">
      <!-- What it is -->
      <article class="moduleCard reveal">
        <h2 class="moduleTitle">What it is</h2>
        <p class="moduleText">
          A lightweight “signal desk” that turns high-signal sources into short, source-linked notes you can skim fast and reference later.
        </p>
        <ul class="moduleList">
          <li>Short, actionable summaries</li>
          <li>Source-linked references</li>
          <li>Tags for fast navigation</li>
          <li>Automation-ready publishing workflow</li>
        </ul>
      </article>

      <!-- Who it's for -->
      <article class="moduleCard reveal">
        <h2 class="moduleTitle">Who it’s for</h2>
        <p class="moduleText">
          Engineers, operators, tech leaders, and builders who want fast, reliable situational awareness — without spending hours scrolling feeds.
        </p>
        <div class="pillRow circlePillRow" style="margin-top: 18px;">
          <span class="pill">CTO / Tech Lead</span>
          <span class="pill">Infra &amp; NetOps</span>
          <span class="pill">AI / Robotics</span>
          <span class="pill">Procurement &amp; Vendors</span>
        </div>
      </article>

      <!-- Topics -->
      <article class="moduleCard reveal">
        <h2 class="moduleTitle">Topics</h2>
        <p class="moduleText">
          The current scope is intentionally broad — with a bias toward real-world engineering and operations.
        </p>

        <div class="tmh-section">
          <div class="tmh-section__head">
            <a class="source" href="/posts">Browse →</a>
          </div>

          <div class="tmh-tagsCloud">
            {topTags.map((t) => (
              <a class="tmh-pill tmh-pill--link" href={`/tags/${t}`}>#{t}</a>
            ))}
          </div>
        </div>

        <p class="moduleText" style="margin-top:12px;">
          Tags are the primary navigation layer — the archive stays clean, searchable, and easy to maintain.
        </p>
      </article>

      <!-- Publishing workflow -->
      <article class="moduleCard reveal">
        <h2 class="moduleTitle">How publishing works</h2>
        <p class="moduleText">
          TechMind Hub follows a strict, automation-friendly workflow: content is proposed via pull requests, every post is reviewed before publishing,
          and the site is deployed automatically after approval.
        </p>
        <ol class="steps">
          <li>Collect → curate sources</li>
          <li>Summarize with links and tags</li>
          <li>Review → merge</li>
          <li>Deploy → publish</li>
        </ol>
      </article>

      <!-- Where to discuss -->
      <article class="moduleCard reveal">
        <h2 class="moduleTitle">Where to discuss</h2>
        <p class="moduleText">
          This site is the archive. Discussions happen in community spaces
          and under social posts linked on each article.
        </p>
        <p class="moduleText">
          The structure is intentional:
        </p>
        <ul class="moduleList">
          <li>The website — structured, source-linked archive</li>
          <li>The Circle — moderated signal-first discussion</li>
          <li>LinkedIn & Facebook — broader industry engagement</li>
        </ul>
        <p class="moduleText">
           Choose the layer that fits your depth.
        </p>

        <div class="pillRow">
          <a class="btn" href={FB_CIRCLE_URL} target="_blank" rel="noopener noreferrer">TechMind Hub Circle</a>
          <a class="btn" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
		  <a class="btn" href={FB_PROFILE_URL} target="_blank" rel="noopener noreferrer">Facebook</a>
        </div>

        <p class="moduleText" style="margin-top:12px;">
          Community rules live on the <a href="/rules/">Сircle</a> page.
        </p>
      </article>

      <!-- Contact -->
      <article class="moduleCard reveal">
        <h2 class="moduleTitle">Contact</h2>
        <p class="moduleText">
          Want updates, collaborations, or to suggest a source? Send a short message.
        </p>

        {import.meta.env.PUBLIC_TURNSTILE_SITEKEY ? (
          <>
            <form class="contactForm" id="tmhContactForm">
			<div class="contactFormInner">
              <div class="formRow" style="gap:12px; align-items:flex-start;">
                <div style="flex:1; display:flex; flex-direction:column; gap:10px;">
                  <div>
                    <label class="label" for="name">Name (optional)</label>
                    <input class="input" id="name" name="name" type="text" placeholder="Your name" autocomplete="name" />
                  </div>

                  <div>
                    <label class="label" for="email">Email</label>
                    <input class="input" id="email" name="email" type="email" placeholder="you@company.com" required autocomplete="email" />
                  </div>

                  <div>
                    <label class="label" for="message">Message</label>
                    <textarea class="input" id="message" name="message" rows="5" placeholder="What’s on your mind?" required></textarea>
                  </div>

                  <!-- Turnstile widget -->
                  <div
                    class="cf-turnstile"
                    data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITEKEY}
                  ></div>

                  <div style="display:flex; gap:10px; align-items:center;">
                    <button class="btn" type="submit" id="tmhContactSubmit">Send</button>
                    <span class="note" id="tmhContactStatus" aria-live="polite"></span>
                  </div>

                  <p class="badge" style="margin-top:6px;">
                    By submitting, you agree to be contacted about TechMind Hub updates. Unsubscribe anytime.
                  </p>
                </div>
              </div>
            </div>
			</form>

            <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

            <script>
              const form = document.getElementById("tmhContactForm");
              const btn = document.getElementById("tmhContactSubmit");
              const statusEl = document.getElementById("tmhContactStatus");

              const endpoint = "/api/contact"; // Worker endpoint

              function setStatus(text) {
                if (statusEl) statusEl.textContent = text || "";
              }

              form?.addEventListener("submit", async (e) => {
                e.preventDefault();
                setStatus("");
                btn?.setAttribute("disabled", "true");
                btn && (btn.textContent = "Sending...");

                try {
                  const fd = new FormData(form);

                  const token = (fd.get("cf-turnstile-response") || "").toString().trim();
                  const payload = {
                    name: (fd.get("name") || "").toString().trim(),
                    email: (fd.get("email") || "").toString().trim(),
                    message: (fd.get("message") || "").toString().trim(),
                    turnstileToken: token,
                  };

                  const res = await fetch(endpoint, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                  });

                  const data = await res.json().catch(() => null);

                  if (res.ok && data?.ok) {
                    form.reset();
                    setStatus("✅ Sent. Thanks!");
                  } else {
                    const err = data?.error || `Request failed (${res.status})`;
                    setStatus("❌ " + err);
                  }
                } catch (err) {
                  setStatus("❌ Network error. Try again.");
                } finally {
                  btn?.removeAttribute("disabled");
                  btn && (btn.textContent = "Send");
                }
              });
            </script>
          </>
        ) : (
          <div class="callout">
            <p class="moduleText" style="margin:0;">
              Turnstile is not configured yet.
              Set <strong>PUBLIC_TURNSTILE_SITEKEY</strong> in your env to enable the form.
            </p>
          </div>
        )}

        <p class="moduleText" style="margin-top:12px;">
          This will evolve over time — TechMind Hub is designed as a “container” where new modules can be added without redesigning everything.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
