---
import domains from "../data/editorial-domains.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export const prerender = true;

const FORM_ACTION = import.meta.env.PUBLIC_TMH_CONTACT_FORM_ACTION;

const FB_CIRCLE_URL =
  import.meta.env.PUBLIC_FB_CIRCLE_URL ||
  "https://www.facebook.com/groups/techmindhub";

const LINKEDIN_URL =
  import.meta.env.PUBLIC_LINKEDIN_URL ||
  "https://www.linkedin.com/in/andrew-rover-799772ba/";

const FB_PROFILE_URL =
  import.meta.env.PUBLIC_FB_PROFILE_URL ||
  "https://www.facebook.com/andrew.rover.2024";

const all = await getCollection("posts", ({ data }) => data.status === "published");

// newest first
const tagCounts = new Map<string, number>();
for (const p of all) {
  for (const t of p.data.tags ?? []) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
  
---

<BaseLayout
  title="About — TechMind Hub"
  description="Meet Andrew Rover and learn how TechMind Hub evaluates emerging technology through primary sources, engineering context and clear limits on claims."
>
  <section class="page">
    <header class="pageHeader">
      <h1 class="pageTitle">About TechMind Hub</h1>
      <p class="pageLead">
        TechMind Hub publishes source-linked engineering analysis across AI, robotics, infrastructure and emerging technology.
        We examine what has been demonstrated, what remains uncertain and what a team would need to test next.
      </p>

      <div class="pageActions">
        <a class="tmh-btn tmh-btn--primary" href="/posts">Browse Analysis</a>
        <a class="tmh-btn" href="/tags">Explore Tags</a>
        <a class="tmh-btn" href="/circle">Join the Circle</a>
      </div>
    </header>
        <div class="aboutGrid reveal">
      <!-- What it is -->
      <article class="moduleCard reveal">
        <h2 class="moduleTitle">What you will find</h2>
        <p class="moduleText">
          Each article connects a specific announcement, release or study to the engineering decisions it may affect.
        </p>
        <ul class="moduleList">
          <li>Primary sources and the scope of their evidence</li>
          <li>Technical mechanisms and practical constraints</li>
          <li>Questions to guide evaluation or implementation</li>
          <li>Clear distinctions between reported results and our assessment</li>
        </ul>
      </article>

      <!-- Who it's for -->
      <article class="moduleCard reveal">
        <h2 class="moduleTitle">Who it’s for</h2>
        <p class="moduleText">
          Engineers, operators, architects and tech leaders who need to judge the implications of a development beyond its headline.
        </p>
        <div class="pillRow circlePillRow" style="margin-top: 18px;">
          <span class="pill">CTO / Tech Lead</span>
          <span class="pill">Infra &amp; NetOps</span>
          <span class="pill">AI / Robotics</span>
          <span class="pill">Procurement &amp; Vendors</span>
        </div>
      </article>

      <!-- Topics -->
      <article class="moduleCard reveal">
        <h2 class="moduleTitle">Topics</h2>
        <p class="moduleText">
          The current scope is intentionally broad — with a bias toward real-world engineering and operations.
        </p>

        <div class="tmh-section">
          <div class="tmh-section__head">
            <a class="source" href="/posts">Browse →</a>
          </div>

          <div class="tmh-tagsCloud">
            {domains.filter(d => tagCounts.has(d.tag)).map((d) => (
              <a class="tmh-pill tmh-pill--link" href={`/tags/${encodeURIComponent(d.tag)}/`}>{d.label}</a>
            ))}
          </div>
        </div>

        <p class="moduleText" style="margin-top:12px;">
          Start with a broad editorial direction, then use the archive search and specific topic tags to narrow the results.
        </p>
      </article>

      <!-- Visual language -->
      <article class="moduleCard reveal" id="visual-language">
        <h2 class="moduleTitle">Our visual language</h2>
        <p class="moduleText">Colour families identify editorial directions. A cover introduces the central idea; illustrations inside the article help explain it. Related images share a visual motif, with different levels of detail.</p>
        <p class="moduleText">Conceptual artwork is distinguished from apparatus diagrams. Sources, reported findings and their limits are explained in the article. Written topic labels accompany every colour cue.</p>
        <ul class="palette-key" aria-label="Editorial colour families">
          {domains.map(domain => <li><span class="palette-key__swatch" style={`background:${domain.accent}`} aria-hidden="true"></span><span>{domain.label}</span></li>)}
        </ul>
      </article>

      <!-- Author and editorial method -->
      <article class="moduleCard reveal">
        <h2 class="moduleTitle">Author and editorial method</h2>
        <p class="moduleText">
          TechMind Hub is founded and edited by Andrew Rover. The analysis draws on original research papers, project documentation,
          security advisories and first-party announcements. A source may describe its own results; we identify that scope rather than treating it as independent validation.
        </p>
        <ol class="steps">
          <li>Identify the event and read the primary source</li>
          <li>Check dates, measurements and the conditions behind claims</li>
          <li>Separate reported findings from engineering interpretation</li>
          <li>Explain limits, trade-offs and useful next tests</li>
        </ol>
        <p class="moduleText">Our commentary is analysis, not a claim that we independently reproduced every reported result. If a material error is found, we correct the article and make the change traceable.</p>
      </article>

      <!-- Where to discuss -->
      <article class="moduleCard reveal">
        <h2 class="moduleTitle">Where to discuss</h2>
        <p class="moduleText">
          This site is the source-linked archive. Conversations can continue in the TechMind Hub Circle and on Andrew Rover's social channels.
        </p>
        <p class="moduleText">
          The structure is intentional:
        </p>
        <ul class="moduleList">
          <li>The website — structured, source-linked archive</li>
          <li>The Circle — moderated signal-first discussion</li>
          <li>LinkedIn & Facebook — broader industry engagement</li>
        </ul>
        <p class="moduleText">
           Choose the layer that fits your depth.
        </p>

        <div class="pillRow">
          <a class="btn" href={FB_CIRCLE_URL} target="_blank" rel="noopener noreferrer">TechMind Hub Circle</a>
          <a class="btn" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
		  <a class="btn" href={FB_PROFILE_URL} target="_blank" rel="noopener noreferrer">Facebook</a>
        </div>

        <p class="moduleText" style="margin-top:12px;">
          Community rules live on the <a href="/rules/">Circle</a> page.
        </p>
      </article>

      <!-- Contact -->
      <article class="moduleCard reveal">
        <h2 class="moduleTitle">Contact</h2>
        <p class="moduleText">
          Want updates, collaborations, or to suggest a source? Send a short message.
        </p>

        {import.meta.env.PUBLIC_TURNSTILE_SITEKEY ? (
          <>
            <form class="contactForm" id="tmhContactForm">
			<div class="contactFormInner">
              <div class="formRow" style="gap:12px; align-items:flex-start;">
                <div style="flex:1; display:flex; flex-direction:column; gap:10px;">
                  <div>
                    <label class="label" for="name">Name (optional)</label>
                    <input class="input" id="name" name="name" type="text" placeholder="Your name" autocomplete="name" />
                  </div>

                  <div>
                    <label class="label" for="email">Email</label>
                    <input class="input" id="email" name="email" type="email" placeholder="you@company.com" required autocomplete="email" />
                  </div>

                  <div>
                    <label class="label" for="message">Message</label>
                    <textarea class="input" id="message" name="message" rows="5" placeholder="What’s on your mind?" required></textarea>
                  </div>

                  <!-- Turnstile widget -->
                  <div
                    class="cf-turnstile"
                    data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITEKEY}
                  ></div>

                  <div style="display:flex; gap:10px; align-items:center;">
                    <button class="btn" type="submit" id="tmhContactSubmit">Send</button>
                    <span class="note" id="tmhContactStatus" aria-live="polite"></span>
                  </div>

                  <p class="badge" style="margin-top:6px;">
                    By submitting, you agree to be contacted about TechMind Hub updates. Unsubscribe anytime.
                  </p>
                </div>
              </div>
            </div>
			</form>

            <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

            <script>
              const form = document.getElementById("tmhContactForm");
              const btn = document.getElementById("tmhContactSubmit");
              const statusEl = document.getElementById("tmhContactStatus");

              const endpoint = "/api/contact"; // Worker endpoint

              function setStatus(text) {
                if (statusEl) statusEl.textContent = text || "";
              }

              form?.addEventListener("submit", async (e) => {
                e.preventDefault();
                setStatus("");
                btn?.setAttribute("disabled", "true");
                btn && (btn.textContent = "Sending...");

                try {
                  const fd = new FormData(form);

                  const token = (fd.get("cf-turnstile-response") || "").toString().trim();
                  const payload = {
                    name: (fd.get("name") || "").toString().trim(),
                    email: (fd.get("email") || "").toString().trim(),
                    message: (fd.get("message") || "").toString().trim(),
                    turnstileToken: token,
                  };

                  const res = await fetch(endpoint, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                  });

                  const data = await res.json().catch(() => null);

                  if (res.ok && data?.ok) {
                    form.reset();
                    setStatus("✅ Sent. Thanks!");
                  } else {
                    const err = data?.error || `Request failed (${res.status})`;
                    setStatus("❌ " + err);
                  }
                } catch (err) {
                  setStatus("❌ Network error. Try again.");
                } finally {
                  btn?.removeAttribute("disabled");
                  btn && (btn.textContent = "Send");
                }
              });
            </script>
          </>
        ) : (
          <div class="callout">
            <p class="moduleText" style="margin:0;">
              Turnstile is not configured yet.
              Set <strong>PUBLIC_TURNSTILE_SITEKEY</strong> in your env to enable the form.
            </p>
          </div>
        )}

      </article>
    </div>
  </section>
</BaseLayout>
