---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

// Build all static routes for published posts
export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.status === "published");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Defensive: if someone opens a draft by direct URL in dev, show 404
if (post.data.status !== "published") {
  return Astro.redirect("/posts");
}

const { title, description, pubDate, tags, source_url, cover_hero, cover_alt, social } = post.data;
const { Content } = await render(post);
const ogImage = new URL(post.data.cover_card, "https://techmindhub.cc").href;
---

<BaseLayout title={title} description={description} ogImage={ogImage} ogType="article" compactHeader>
  <article class="post">
    <header class="post__header">
      {post.data.topic && <a class="post__topic" href={`/tags/${encodeURIComponent(tags[0])}/`}>{post.data.topic}</a>}
      <h1 class="post__title">{title}</h1>
      <p class="post__description">{description}</p>

      <div class="post__meta">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toISOString().slice(0, 10)}
        </time>

        {source_url && (
          <>
            <span class="dot">·</span>
            <a class="source" href={source_url} target="_blank" rel="noopener noreferrer">
              Source ↗
            </a>
          </>
        )}
      </div>


      {tags?.length ? (
        <div class="tmh-tagsCloud">
          {tags.map((t) => (
            <a class="tmh-pill tmh-pill--link" href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>
          ))}
        </div>
      ) : null}

      {(social?.linkedin || social?.facebook) && (
        <div class="post__social">
          {social?.linkedin && (
            <a class="btn" href={social.linkedin} target="_blank" rel="noopener noreferrer">
              Discuss on LinkedIn
            </a>
          )}
          {social?.facebook && (
            <a class="btn" href={social.facebook} target="_blank" rel="noopener noreferrer">
              Discuss on Facebook
            </a>
          )}
        </div>
      )}
    </header>

    {cover_hero && (
      <figure class="post__hero">
        <img src={cover_hero} alt={cover_alt || title} loading="eager" decoding="async" />
      </figure>
    )}

    <div class="post__content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post { max-width: 850px; margin-inline: auto; padding-top: 30px; }
  .post__title { font-size: clamp(1.9rem, 4.5vw, 2.8rem); overflow-wrap: anywhere; }
  .post__description { font-size: 1.15rem; line-height: 1.65; color: var(--tmh-muted); }
  .post__meta { flex-wrap: wrap; }
  .post__topic { display: inline-block; margin-bottom: 16px; color: var(--tmh-primary); font-size: .8rem; font-weight: 750; letter-spacing: .09em; text-transform: uppercase; text-underline-offset: .2em; }
  .post__hero { max-width: 680px; margin: 26px auto; }
  .post__content :global(img) { display: block; width: 100%; max-width: 680px; height: auto; margin: 30px auto; border-radius: 14px; }
  .post__content { font-size: 1.075rem; line-height: 1.8; overflow-wrap: anywhere; }
  .post__content :global(h2) { margin: 2em 0 .6em; line-height: 1.3; font-size: 1.5rem; }
  .post__content :global(p) { margin: 0 0 1.2em; }
  .post__content :global(li) { margin-bottom: .6em; }
  .post__content :global(a) { color: var(--tmh-primary); text-underline-offset: .18em; }
  .post__content :global(pre) { padding: 20px; border-radius: 12px; overflow-x: auto; font-size: .9em; }
  .post__content :global(:not(pre) > code) { padding: .1em .3em; border-radius: 4px; background: #e9f0f5; font-size: .9em; }
  @media (max-width: 600px) {
    .post { padding-top: 20px; }
    .post__content { font-size: 1rem; }
    .post__content :global(pre) { padding: 14px; }
  }
</style>
