---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { formatEditorialDate } from "../../lib/editorial-date";
import { collections, articleInCollection } from "../../data/discovery";
import domains from "../../data/editorial-domains.json";

// Build all static routes for published posts
export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.status === "published");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Defensive: if someone opens a draft by direct URL in dev, show 404
if (post.data.status !== "published") {
  return Astro.redirect("/posts");
}

const { title, description, pubDate, author, tags, source_url, cover_hero, cover_alt, social } = post.data;
const { Content } = await render(post);
const ogImage = new URL(post.data.cover_og!, "https://techmindhub.cc").href;
const articleUrl = `https://techmindhub.cc/posts/${encodeURIComponent(post.slug)}/`;
const LINKEDIN_URL = import.meta.env.PUBLIC_LINKEDIN_URL || "https://www.linkedin.com/in/andrew-rover-799772ba/";
const FACEBOOK_PAGE_URL = import.meta.env.PUBLIC_TMH_FACEBOOK_PAGE_URL;
const FACEBOOK_CIRCLE_URL = import.meta.env.PUBLIC_FB_CIRCLE_URL || "https://www.facebook.com/groups/techmindhub";
const relatedCollections = collections.filter(collection => articleInCollection(tags, collection.tags));
const broadTags = new Set(["TechMindHub", "Research", "Engineering", ...domains.map(domain => domain.tag)]);
const related = (await getCollection("posts", ({ data }) => data.status === "published"))
  .filter(candidate => candidate.slug !== post.slug)
  .map(candidate => ({ post: candidate, overlap: candidate.data.tags.filter(tag => !broadTags.has(tag) && tags.includes(tag)).length }))
  .filter(candidate => candidate.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap || +b.post.data.pubDate - +a.post.data.pubDate)
  .slice(0, 3);
const structuredData = {
  "@context": "https://schema.org", "@type": "BlogPosting",
  headline: title, description,
  image: [ogImage],
  datePublished: pubDate.toISOString(),
  mainEntityOfPage: { "@type": "WebPage", "@id": articleUrl },
  author: { "@type": "Person", name: author, ...(author === "Andrew Rover" ? { url: LINKEDIN_URL } : {}) },
  publisher: { "@type": "Organization", name: "TechMind Hub", url: "https://techmindhub.cc/", logo: { "@type": "ImageObject", url: "https://techmindhub.cc/logo.webp" } },
};
---

<BaseLayout title={title} description={description} author={author} ogImage={ogImage} ogType="article" compactHeader structuredData={structuredData}>
  <article class="post">
    <header class="post__header">
      {post.data.topic && <a class="post__topic" href={`/tags/${encodeURIComponent(tags[0])}/`}>{post.data.topic}</a>}
      <h1 class="post__title">{title}</h1>
      {post.data.format === "deep-dive" && <p class="editorial-format">Deep Dive · Strategic Analysis</p>}
      <p class="post__description">{description}</p>

      <div class="post__meta">
        <span>By {author}</span>
        <span class="dot">·</span>
        <time datetime={pubDate.toISOString()}>
          {formatEditorialDate(pubDate)}
        </time>

        {source_url && (
          <>
            <span class="dot">·</span>
            <a class="source" href={source_url} target="_blank" rel="noopener noreferrer">
              Source ↗
            </a>
          </>
        )}
      </div>


      {tags?.length ? (
        <div class="tmh-tagsCloud">
          {tags.map((t) => (
            <a class="tmh-pill tmh-pill--link" href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>
          ))}
        </div>
      ) : null}

    </header>

    {cover_hero && (
      <figure class="post__hero">
        <img src={cover_hero} alt={cover_alt || title} loading="eager" decoding="async" />
      </figure>
    )}

    <div class="post__content">
      <Content />
    </div>

    <aside class="post-follow" aria-label="Follow and continue reading">
      <h2>Follow the analysis</h2>
      <p>For new research, engineering context and discussion, follow TechMind Hub across these channels.</p>
      <div class="post__social">
        <a class="tmh-btn tmh-btn--primary" href="https://arover.substack.com/" target="_blank" rel="noopener noreferrer">Substack</a>
        <a class="tmh-btn" href={social?.facebook || FACEBOOK_PAGE_URL || FACEBOOK_CIRCLE_URL} target="_blank" rel="noopener noreferrer">{social?.facebook ? "Discuss on Facebook" : FACEBOOK_PAGE_URL ? "TechMind Hub on Facebook" : "Facebook community"}</a>
        <a class="tmh-btn" href={social?.linkedin || LINKEDIN_URL} target="_blank" rel="noopener noreferrer">{social?.linkedin ? "Discuss on LinkedIn" : "Andrew Rover on LinkedIn"}</a>
        <a class="tmh-btn" href="/feed.xml">RSS feed</a>
      </div>
    </aside>

    {relatedCollections.length > 0 && <aside class="post-related"><h2>Explore this subject</h2><div class="tmh-tagsCloud">{relatedCollections.map(collection => <a class="tmh-pill tmh-pill--link" href={`/collections/${collection.id}/`}>{collection.label}</a>)}</div></aside>}
    {related.length > 0 && <aside class="post-related"><h2>Related analysis</h2><ul>{related.map(item => <li><a href={`/posts/${item.post.slug}/`}>{item.post.data.title}</a></li>)}</ul></aside>}
  </article>
</BaseLayout>

<style>
  .post { max-width: 850px; margin-inline: auto; padding-top: 30px; }
  .post__title { font-size: clamp(1.9rem, 4.5vw, 2.8rem); overflow-wrap: anywhere; }
  .post__description { font-size: 1.15rem; line-height: 1.65; color: var(--tmh-muted); }
  .post__meta { flex-wrap: wrap; }
  .post__topic { display: inline-block; margin-bottom: 16px; color: var(--tmh-primary); font-size: .8rem; font-weight: 750; letter-spacing: .09em; text-transform: uppercase; text-underline-offset: .2em; }
  .post__hero { max-width: 680px; margin: 26px auto; }
  .post__content :global(img) { display: block; width: 100%; max-width: 680px; height: auto; margin: 30px auto; border-radius: 14px; }
  .post__content { font-size: 1.075rem; line-height: 1.8; overflow-wrap: anywhere; }
  .post__content :global(h2) { margin: 2em 0 .6em; line-height: 1.3; font-size: 1.5rem; }
  .post__content :global(p) { margin: 0 0 1.2em; }
  .post__content :global(li) { margin-bottom: .6em; }
  .post__content :global(a) { color: var(--tmh-primary); text-underline-offset: .18em; }
  .post__content :global(pre) { padding: 20px; border-radius: 12px; overflow-x: auto; font-size: .9em; }
  .post__content :global(:not(pre) > code) { padding: .1em .3em; border-radius: 4px; background: #e9f0f5; font-size: .9em; }
  .editorial-format { color: var(--tmh-primary); font-size: .8rem; letter-spacing: .09em; font-weight: 750; text-transform: uppercase; }
  .post-follow, .post-related { border-top: 1px solid var(--tmh-border); padding: 22px 0; margin-top: 28px; }
  .post-follow h2, .post-related h2 { font-size: 1.25rem; margin: 0 0 10px; }
  .post-follow p { color: var(--tmh-muted); line-height: 1.5; }
  .post-related li { margin: 9px 0; line-height: 1.5; }
  .post-related a { color: var(--tmh-primary); }
  @media (max-width: 600px) {
    .post { padding-top: 20px; }
    .post__content { font-size: 1rem; }
    .post__content :global(pre) { padding: 14px; }
  }
</style>
